# ── Database ──────────────────────────────────────────────
# Backend: "sqlite" (no install needed) or "postgres" (Docker required)
DB_BACKEND=sqlite
SQLITE_PATH=cp_finder.db

# Only needed if DB_BACKEND=postgres:
# DATABASE_URL=postgresql+psycopg://cpfinder:cpfinder_dev@localhost:5432/cpfinder

# ── LLM Provider ─────────────────────────────────────────
# Options: "ollama" (free, local), "gemini" (free tier), "anthropic" (paid)
LLM_PROVIDER=ollama

# Ollama (DEFAULT — free, local)
# Install: https://ollama.com → then run: ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Google Gemini (free tier: 15 RPM, 1M tokens/day)
# Get key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Anthropic Claude (paid — best quality)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI / Groq / DeepSeek / OpenRouter (paid or free tier)
# Set LLM_PROVIDER=openai_compatible
# OPENAI_API_KEY=your_key_here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1   # example for Groq
# OPENAI_FAST_MODEL=llama3-70b-8192                # example for Groq
# OPENAI_STRONG_MODEL=llama3-70b-8192

# ── Embedding Provider ───────────────────────────────────
# Options: "local" (sentence-transformers, free), "voyage" (paid)
EMBEDDING_PROVIDER=local

# Local embeddings (DEFAULT — free, runs on CPU)
LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Voyage AI (paid — better quality)
# VOYAGE_API_KEY=pa-...
# VOYAGE_EMBED_MODEL=voyage-3.5

# ── Extraction ───────────────────────────────────────────
SELF_CONSISTENCY_RUNS=2

# ── Ingestion ────────────────────────────────────────────
# CLIST_API_KEY=             # clist.by API key (Phase 2)
CODECHEF_ENABLED=false
LEETCODE_ENABLED=false
